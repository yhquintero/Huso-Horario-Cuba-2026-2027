#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Cuba Hora 2027 - Ajuste profesional de zona horaria de Cuba
.DESCRIPTION
    Herramienta gráfica profesional para configurar correctamente el horario de 
    Cuba (mantener DST hasta el 7 de noviembre de 2027).
    Incluye icono en la bandeja del sistema, verificación y logs.
.NOTES
    Autor: PC Pro Tech / Yosvany
    Fecha: Octubre 2026
#>

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

# ============================================================
# CONFIGURACIÓN Y CONSTANTES
# ============================================================

$Script:AppName        = "Cuba Hora 2027"
$Script:AppVersion     = "1.2.0"
$Script:LogPath        = "$env:TEMP\CubaHora2027.log"
$Script:RegistryPath   = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Time Zones\Cuba Standard Time"
$Script:DynamicDSTPath = "$Script:RegistryPath\Dynamic DST"

# Datos binarios verificados (44 bytes cada uno)
$Script:TZI_2026 = [byte[]](0xf0,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xc4,0xff,0xff,0xff,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00)
$Script:TZI_2027 = [byte[]](0x2c,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0xc4,0xff,0xff,0xff,0x00,0x00,0x0b,0x00,0x00,0x00,0x01,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00)
$Script:TZI_Main = $Script:TZI_2027

# ============================================================
# FUNCIONES DE LOGGING
# ============================================================

function Write-Log {
    param(
        [string]$Message,
        [ValidateSet("INFO","OK","WARN","ERROR")]
        [string]$Level = "INFO"
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $line = "[$timestamp] [$Level] $Message"
    Add-Content -Path $Script:LogPath -Value $line -Encoding UTF8 -ErrorAction SilentlyContinue
    
    if ($Script:txtLog -and -not $Script:txtLog.IsDisposed) {
        $color = switch ($Level) {
            "OK"    { [System.Drawing.Color]::FromArgb(0,140,70) }
            "WARN"  { [System.Drawing.Color]::FromArgb(180,120,0) }
            "ERROR" { [System.Drawing.Color]::FromArgb(180,30,30) }
            default { [System.Drawing.Color]::FromArgb(40,40,40) }
        }
        $Script:txtLog.SelectionStart = $Script:txtLog.TextLength
        $Script:txtLog.SelectionColor = $color
        $Script:txtLog.AppendText("$line`r`n")
        $Script:txtLog.ScrollToCaret()
    }
}

# ============================================================
# FUNCIONES DE ZONA HORARIA
# ============================================================

function Test-IsAdmin {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Get-CurrentTimeZoneInfo {
    try {
        $tz = [System.TimeZoneInfo]::Local
        $now = Get-Date
        $isDst = $tz.IsDaylightSavingTime($now)
        
        $next = $null
        try {
            $rules = $tz.GetAdjustmentRules()
            if ($rules) {
                $future = $rules | Where-Object { $_.DateStart -le $now.AddYears(2) } | Sort-Object DateStart -Descending | Select-Object -First 1
                if ($future) {
                    $next = if ($isDst) { $future.DaylightTransitionEnd } else { $future.DaylightTransitionStart }
                }
            }
        } catch {}

        return [PSCustomObject]@{
            Id              = $tz.Id
            DisplayName     = $tz.DisplayName
            StandardName    = $tz.StandardName
            DaylightName    = $tz.DaylightName
            BaseUtcOffset   = $tz.BaseUtcOffset
            SupportsDST     = $tz.SupportsDaylightSavingTime
            IsDaylightTime  = $isDst
            CurrentOffset   = if ($isDst) { $tz.BaseUtcOffset.Add([TimeSpan]::FromHours(1)) } else { $tz.BaseUtcOffset }
            NextTransition  = $next
        }
    } catch {
        Write-Log "Error obteniendo info de zona: $_" "ERROR"
        return $null
    }
}

function Clear-CubaDynamicDST {
    Write-Log "Eliminando clave Dynamic DST existente..." "INFO"
    try {
        if (Test-Path $Script:DynamicDSTPath) {
            Remove-Item -Path $Script:DynamicDSTPath -Recurse -Force -ErrorAction Stop
            Write-Log "Clave Dynamic DST eliminada correctamente." "OK"
        } else {
            Write-Log "No existía clave Dynamic DST (OK)." "INFO"
        }
        return $true
    } catch {
        Write-Log "Error al limpiar Dynamic DST: $_" "ERROR"
        return $false
    }
}

function Set-CubaRegistry {
    Write-Log "Aplicando configuración de registro para Cuba 2026-2027..." "INFO"
    
    try {
        # Asegurar que existe la clave principal
        if (-not (Test-Path $Script:RegistryPath)) {
            New-Item -Path $Script:RegistryPath -Force | Out-Null
        }

        # Valores de texto
        Set-ItemProperty -Path $Script:RegistryPath -Name "Display" -Value "(UTC-05:00) La Habana" -Type String -Force
        Set-ItemProperty -Path $Script:RegistryPath -Name "Dlt"     -Value "Cuba Daylight Time" -Type String -Force
        Set-ItemProperty -Path $Script:RegistryPath -Name "Std"     -Value "Cuba Standard Time" -Type String -Force
        Set-ItemProperty -Path $Script:RegistryPath -Name "MapID"   -Value "-1,84" -Type String -Force
        
        # TZI principal (solo fin de DST el 7 nov 2027)
        Set-ItemProperty -Path $Script:RegistryPath -Name "TZI" -Value $Script:TZI_Main -Type Binary -Force
        Write-Log "TZI principal escrito (44 bytes)." "OK"

        # Crear Dynamic DST
        if (-not (Test-Path $Script:DynamicDSTPath)) {
            New-Item -Path $Script:DynamicDSTPath -Force | Out-Null
        }

        Set-ItemProperty -Path $Script:DynamicDSTPath -Name "FirstEntry" -Value 0x7EA -Type DWord -Force  # 2026
        Set-ItemProperty -Path $Script:DynamicDSTPath -Name "LastEntry"  -Value 0x7EB -Type DWord -Force  # 2027
        
        # 2026 = DST permanente (Bias 240)
        Set-ItemProperty -Path $Script:DynamicDSTPath -Name "2026" -Value $Script:TZI_2026 -Type Binary -Force
        Write-Log "Entrada Dynamic DST 2026 (permanente) aplicada." "OK"
        
        # 2027 = solo fin el 7 de noviembre
        Set-ItemProperty -Path $Script:DynamicDSTPath -Name "2027" -Value $Script:TZI_2027 -Type Binary -Force
        Write-Log "Entrada Dynamic DST 2027 (fin 7/nov) aplicada." "OK"

        return $true
    } catch {
        Write-Log "Error escribiendo registro: $_" "ERROR"
        return $false
    }
}

function Set-CubaTimeZone {
    Write-Log "Estableciendo zona horaria 'Cuba Standard Time'..." "INFO"
    try {
        $result = & tzutil.exe /s "Cuba Standard Time" 2>&1
        if ($LASTEXITCODE -eq 0) {
            Write-Log "Zona horaria establecida correctamente." "OK"
            return $true
        } else {
            Write-Log "tzutil falló (código $LASTEXITCODE): $result" "ERROR"
            return $false
        }
    } catch {
        Write-Log "Excepción en tzutil: $_" "ERROR"
        return $false
    }
}

function Restart-TimeServices {
    Write-Log "Reiniciando servicio de hora de Windows (W32Time)..." "INFO"
    try {
        Stop-Service -Name w32time -Force -ErrorAction SilentlyContinue
        Start-Sleep -Milliseconds 800
        Start-Service -Name w32time -ErrorAction Stop
        Write-Log "Servicio W32Time reiniciado." "OK"
        
        # Intentar resync
        $null = & w32tm.exe /resync /force 2>&1
        Write-Log "Sincronización de hora forzada." "OK"
        return $true
    } catch {
        Write-Log "Advertencia al reiniciar servicios: $_" "WARN"
        return $false
    }
}

function Apply-FullFix {
    Write-Log "========== INICIANDO APLICACIÓN COMPLETA ==========" "INFO"
    
    $ok = $true
    $ok = (Clear-CubaDynamicDST) -and $ok
    $ok = (Set-CubaRegistry) -and $ok
    $ok = (Set-CubaTimeZone) -and $ok
    $ok = (Restart-TimeServices) -and $ok
    
    if ($ok) {
        Write-Log "========== APLICACIÓN COMPLETADA CON ÉXITO ==========" "OK"
        Write-Log "Reinicia el equipo para que el cambio se refleje completamente en la interfaz de Windows." "WARN"
    } else {
        Write-Log "========== APLICACIÓN FINALIZADA CON ERRORES ==========" "ERROR"
    }
    
    Update-StatusPanel
    return $ok
}

function Get-VerificationReport {
    $report = New-Object System.Text.StringBuilder
    
    [void]$report.AppendLine("=== VERIFICACIÓN DE ZONA HORARIA CUBA ===")
    [void]$report.AppendLine("Fecha/Hora del sistema: $(Get-Date -Format 'dddd, dd MMMM yyyy HH:mm:ss')")
    [void]$report.AppendLine("")
    
    # Zona actual
    $info = Get-CurrentTimeZoneInfo
    if ($info) {
        [void]$report.AppendLine("Zona actual ID      : $($info.Id)")
        [void]$report.AppendLine("Nombre mostrado     : $($info.DisplayName)")
        [void]$report.AppendLine("Soporta DST         : $($info.SupportsDST)")
        [void]$report.AppendLine("¿Está en horario de verano ahora? : $($info.IsDaylightTime)")
        [void]$report.AppendLine("Offset actual       : $($info.CurrentOffset)")
    }
    
    [void]$report.AppendLine("")
    [void]$report.AppendLine("--- Registro (Dynamic DST) ---")
    
    if (Test-Path $Script:DynamicDSTPath) {
        $first = (Get-ItemProperty $Script:DynamicDSTPath -Name FirstEntry -ErrorAction SilentlyContinue).FirstEntry
        $last  = (Get-ItemProperty $Script:DynamicDSTPath -Name LastEntry  -ErrorAction SilentlyContinue).LastEntry
        [void]$report.AppendLine("FirstEntry : $first (2026 = 0x7EA)")
        [void]$report.AppendLine("LastEntry  : $last  (2027 = 0x7EB)")
        
        $has2026 = $null -ne (Get-ItemProperty $Script:DynamicDSTPath -Name "2026" -ErrorAction SilentlyContinue)
        $has2027 = $null -ne (Get-ItemProperty $Script:DynamicDSTPath -Name "2027" -ErrorAction SilentlyContinue)
        [void]$report.AppendLine("Entrada 2026 presente : $has2026")
        [void]$report.AppendLine("Entrada 2027 presente : $has2027")
        
        if ($has2026) {
            $b2026 = (Get-ItemProperty $Script:DynamicDSTPath -Name "2026")."2026"
            [void]$report.AppendLine("Tamaño TZI 2026       : $($b2026.Length) bytes (debe ser 44)")
        }
        if ($has2027) {
            $b2027 = (Get-ItemProperty $Script:DynamicDSTPath -Name "2027")."2027"
            [void]$report.AppendLine("Tamaño TZI 2027       : $($b2027.Length) bytes (debe ser 44)")
        }
    } else {
        [void]$report.AppendLine("¡No existe la clave Dynamic DST!")
    }
    
    [void]$report.AppendLine("")
    [void]$report.AppendLine("--- Resultado esperado ---")
    [void]$report.AppendLine("Después de reiniciar, la ventana de Fecha y hora debe decir:")
    [void]$report.AppendLine('"El horario de verano finaliza el domingo, 7 de noviembre de 2027 a la 1:00."')
    
    return $report.ToString()
}

# ============================================================
# INTERFAZ GRÁFICA
# ============================================================

function Update-StatusPanel {
    $info = Get-CurrentTimeZoneInfo
    if ($info) {
        $Script:lblZona.Text     = $info.DisplayName
        $Script:lblOffset.Text   = "Offset actual: $($info.CurrentOffset)  |  DST activo: $($info.IsDaylightTime)"
        $Script:lblId.Text       = "ID: $($info.Id)"
        
        if ($info.Id -eq "Cuba Standard Time") {
            $Script:lblEstado.Text = "Zona Cuba detectada"
            $Script:lblEstado.ForeColor = [System.Drawing.Color]::FromArgb(0,130,60)
        } else {
            $Script:lblEstado.Text = "Zona actual NO es Cuba"
            $Script:lblEstado.ForeColor = [System.Drawing.Color]::FromArgb(180,80,0)
        }
    }
}

function Show-MainForm {
    $form = New-Object System.Windows.Forms.Form
    $form.Text = "$Script:AppName  v$Script:AppVersion"
    $form.Size = New-Object System.Drawing.Size(720, 580)
    $form.StartPosition = "CenterScreen"
    $form.FormBorderStyle = "FixedSingle"
    $form.MaximizeBox = $false
    $form.BackColor = [System.Drawing.Color]::FromArgb(245, 247, 250)
    $form.Font = New-Object System.Drawing.Font("Segoe UI", 9)

    # ---- Header ----
    $pnlHeader = New-Object System.Windows.Forms.Panel
    $pnlHeader.Dock = "Top"
    $pnlHeader.Height = 70
    $pnlHeader.BackColor = [System.Drawing.Color]::FromArgb(0, 90, 158)
    $form.Controls.Add($pnlHeader)

    $lblTitle = New-Object System.Windows.Forms.Label
    $lblTitle.Text = "Cuba Hora 2027"
    $lblTitle.Font = New-Object System.Drawing.Font("Segoe UI Semibold", 18)
    $lblTitle.ForeColor = [System.Drawing.Color]::White
    $lblTitle.Location = New-Object System.Drawing.Point(20, 12)
    $lblTitle.AutoSize = $true
    $pnlHeader.Controls.Add($lblTitle)

    $lblSub = New-Object System.Windows.Forms.Label
    $lblSub.Text = "Mantener horario de verano hasta el 7 de noviembre de 2027"
    $lblSub.Font = New-Object System.Drawing.Font("Segoe UI", 9)
    $lblSub.ForeColor = [System.Drawing.Color]::FromArgb(200, 220, 240)
    $lblSub.Location = New-Object System.Drawing.Point(22, 42)
    $lblSub.AutoSize = $true
    $pnlHeader.Controls.Add($lblSub)

    # ---- Panel de estado ----
    $pnlStatus = New-Object System.Windows.Forms.GroupBox
    $pnlStatus.Text = "Estado actual del sistema"
    $pnlStatus.Location = New-Object System.Drawing.Point(20, 85)
    $pnlStatus.Size = New-Object System.Drawing.Size(660, 100)
    $form.Controls.Add($pnlStatus)

    $Script:lblZona = New-Object System.Windows.Forms.Label
    $Script:lblZona.Location = New-Object System.Drawing.Point(15, 25)
    $Script:lblZona.Size = New-Object System.Drawing.Size(620, 20)
    $Script:lblZona.Font = New-Object System.Drawing.Font("Segoe UI Semibold", 10)
    $pnlStatus.Controls.Add($Script:lblZona)

    $Script:lblOffset = New-Object System.Windows.Forms.Label
    $Script:lblOffset.Location = New-Object System.Drawing.Point(15, 48)
    $Script:lblOffset.Size = New-Object System.Drawing.Size(620, 18)
    $pnlStatus.Controls.Add($Script:lblOffset)

    $Script:lblId = New-Object System.Windows.Forms.Label
    $Script:lblId.Location = New-Object System.Drawing.Point(15, 68)
    $Script:lblId.Size = New-Object System.Drawing.Size(400, 18)
    $pnlStatus.Controls.Add($Script:lblId)

    $Script:lblEstado = New-Object System.Windows.Forms.Label
    $Script:lblEstado.Location = New-Object System.Drawing.Point(420, 68)
    $Script:lblEstado.Size = New-Object System.Drawing.Size(220, 18)
    $Script:lblEstado.TextAlign = "MiddleRight"
    $pnlStatus.Controls.Add($Script:lblEstado)

    # ---- Botones principales ----
    $btnApply = New-Object System.Windows.Forms.Button
    $btnApply.Text = "Aplicar corrección completa"
    $btnApply.Location = New-Object System.Drawing.Point(20, 200)
    $btnApply.Size = New-Object System.Drawing.Size(210, 38)
    $btnApply.BackColor = [System.Drawing.Color]::FromArgb(0, 120, 215)
    $btnApply.ForeColor = [System.Drawing.Color]::White
    $btnApply.FlatStyle = "Flat"
    $btnApply.Font = New-Object System.Drawing.Font("Segoe UI Semibold", 9)
    $btnApply.Cursor = [System.Windows.Forms.Cursors]::Hand
    $form.Controls.Add($btnApply)

    $btnVerify = New-Object System.Windows.Forms.Button
    $btnVerify.Text = "Verificar configuración"
    $btnVerify.Location = New-Object System.Drawing.Point(245, 200)
    $btnVerify.Size = New-Object System.Drawing.Size(180, 38)
    $btnVerify.BackColor = [System.Drawing.Color]::FromArgb(70, 70, 70)
    $btnVerify.ForeColor = [System.Drawing.Color]::White
    $btnVerify.FlatStyle = "Flat"
    $btnVerify.Cursor = [System.Windows.Forms.Cursors]::Hand
    $form.Controls.Add($btnVerify)

    $btnRefresh = New-Object System.Windows.Forms.Button
    $btnRefresh.Text = "Actualizar estado"
    $btnRefresh.Location = New-Object System.Drawing.Point(440, 200)
    $btnRefresh.Size = New-Object System.Drawing.Size(140, 38)
    $btnRefresh.FlatStyle = "Flat"
    $btnRefresh.Cursor = [System.Windows.Forms.Cursors]::Hand
    $form.Controls.Add($btnRefresh)

    $btnOpenDate = New-Object System.Windows.Forms.Button
    $btnOpenDate.Text = "Abrir Fecha y hora"
    $btnOpenDate.Location = New-Object System.Drawing.Point(590, 200)
    $btnOpenDate.Size = New-Object System.Drawing.Size(90, 38)
    $btnOpenDate.FlatStyle = "Flat"
    $btnOpenDate.Cursor = [System.Windows.Forms.Cursors]::Hand
    $form.Controls.Add($btnOpenDate)

    # ---- Log ----
    $lblLog = New-Object System.Windows.Forms.Label
    $lblLog.Text = "Registro de operaciones:"
    $lblLog.Location = New-Object System.Drawing.Point(20, 250)
    $lblLog.AutoSize = $true
    $form.Controls.Add($lblLog)

    $Script:txtLog = New-Object System.Windows.Forms.RichTextBox
    $Script:txtLog.Location = New-Object System.Drawing.Point(20, 270)
    $Script:txtLog.Size = New-Object System.Drawing.Size(660, 200)
    $Script:txtLog.Font = New-Object System.Drawing.Font("Consolas", 8.5)
    $Script:txtLog.ReadOnly = $true
    $Script:txtLog.BackColor = [System.Drawing.Color]::FromArgb(250, 250, 250)
    $Script:txtLog.BorderStyle = "FixedSingle"
    $form.Controls.Add($Script:txtLog)

    # ---- Footer ----
    $lblFooter = New-Object System.Windows.Forms.Label
    $lblFooter.Text = "Después de aplicar la corrección es recomendable reiniciar el equipo.  |  Log: $Script:LogPath"
    $lblFooter.Location = New-Object System.Drawing.Point(20, 480)
    $lblFooter.Size = New-Object System.Drawing.Size(660, 20)
    $lblFooter.ForeColor = [System.Drawing.Color]::Gray
    $form.Controls.Add($lblFooter)

    # ---- Eventos ----
    $btnApply.Add_Click({
        $btnApply.Enabled = $false
        $btnApply.Text = "Aplicando..."
        [System.Windows.Forms.Application]::DoEvents()
        
        $result = Apply-FullFix
        
        $btnApply.Enabled = $true
        $btnApply.Text = "Aplicar corrección completa"
        
        if ($result) {
            [System.Windows.Forms.MessageBox]::Show(
                "Corrección aplicada correctamente.`n`nReinicia el equipo y luego abre 'Fecha y hora' para verificar que diga:`n`nEl horario de verano finaliza el domingo, 7 de noviembre de 2027 a la 1:00.",
                "Éxito",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Information
            )
        } else {
            [System.Windows.Forms.MessageBox]::Show(
                "Hubo errores durante la aplicación. Revisa el registro de operaciones.",
                "Error",
                [System.Windows.Forms.MessageBoxButtons]::OK,
                [System.Windows.Forms.MessageBoxIcon]::Error
            )
        }
    })

    $btnVerify.Add_Click({
        $report = Get-VerificationReport
        Write-Log "--- Verificación solicitada por el usuario ---" "INFO"
        $Script:txtLog.AppendText("`r`n$report`r`n")
        $Script:txtLog.ScrollToCaret()
        
        [System.Windows.Forms.MessageBox]::Show(
            $report,
            "Informe de verificación",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Information
        )
    })

    $btnRefresh.Add_Click({
        Update-StatusPanel
        Write-Log "Estado actualizado manualmente." "INFO"
    })

    $btnOpenDate.Add_Click({
        Start-Process "timedate.cpl"
    })

    # Icono de bandeja
    $notify = New-Object System.Windows.Forms.NotifyIcon
    $notify.Icon = [System.Drawing.SystemIcons]::Information
    $notify.Text = $Script:AppName
    $notify.Visible = $true

    $menu = New-Object System.Windows.Forms.ContextMenuStrip
    $itemShow = $menu.Items.Add("Mostrar ventana")
    $itemApply = $menu.Items.Add("Aplicar corrección")
    $itemVerify = $menu.Items.Add("Verificar")
    $menu.Items.Add("-") | Out-Null
    $itemExit = $menu.Items.Add("Salir")
    $notify.ContextMenuStrip = $menu

    $itemShow.Add_Click({ $form.Show(); $form.WindowState = "Normal"; $form.Activate() })
    $itemApply.Add_Click({ $btnApply.PerformClick() })
    $itemVerify.Add_Click({ $btnVerify.PerformClick() })
    $itemExit.Add_Click({ $notify.Visible = $false; $form.Close() })

    $notify.Add_DoubleClick({ $form.Show(); $form.WindowState = "Normal"; $form.Activate() })

    $form.Add_Resize({
        if ($form.WindowState -eq "Minimized") {
            $form.Hide()
            $notify.ShowBalloonTip(2000, $Script:AppName, "La aplicación sigue ejecutándose en la bandeja del sistema.", [System.Windows.Forms.ToolTipIcon]::Info)
        }
    })

    $form.Add_FormClosing({
        param($s, $e)
        if ($e.CloseReason -eq "UserClosing") {
            $e.Cancel = $true
            $form.Hide()
            $notify.ShowBalloonTip(1500, $Script:AppName, "Minimizado a la bandeja. Clic derecho para opciones.", [System.Windows.Forms.ToolTipIcon]::Info)
        }
    })

    $form.Add_Shown({
        Update-StatusPanel
        Write-Log "$Script:AppName v$Script:AppVersion iniciado." "INFO"
        Write-Log "Ejecutando como Administrador: $(Test-IsAdmin)" "INFO"
    })

    # Guardar referencias
    $Script:MainForm = $form
    $Script:NotifyIcon = $notify

    [System.Windows.Forms.Application]::Run($form)
    
    $notify.Visible = $false
    $notify.Dispose()
}

# ============================================================
# PUNTO DE ENTRADA
# ============================================================

if (-not (Test-IsAdmin)) {
    $msg = "Esta herramienta necesita privilegios de Administrador.`n`nSe reiniciará solicitando elevación."
    [System.Windows.Forms.MessageBox]::Show($msg, $Script:AppName, "OK", "Warning")
    
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = "powershell.exe"
    $psi.Arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    $psi.Verb = "runas"
    try {
        [System.Diagnostics.Process]::Start($psi) | Out-Null
    } catch {
        [System.Windows.Forms.MessageBox]::Show("No se pudo elevar privilegios.", "Error", "OK", "Error")
    }
    exit
}

# Crear log inicial
if (-not (Test-Path $Script:LogPath)) {
    New-Item -Path $Script:LogPath -ItemType File -Force | Out-Null
}

Show-MainForm
